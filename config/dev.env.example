# Local development settings (synthetic data only). `make env` copies this to .env and
# generates SESSION_KEY; .env is untracked. No secret belongs in this file.
PUBLIC_BASE_URL=http://localhost:3103
DATABASE_URL=postgresql+psycopg://supplementpacket_app@localhost:5432/supplementpacket_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER_ROLE@localhost:5432/supplementpacket_dev
STORAGE_BUCKET=.run/storage
SESSION_KEY=
API_PORT=8103
LOG_LEVEL=INFO
WORKER_HEARTBEAT_PATH=.run/worker.heartbeat

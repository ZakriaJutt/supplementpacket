# Local development settings (synthetic data only). `make env` copies this to .env and
# generates SESSION_KEY; .env is untracked. No secret belongs in this file.
PUBLIC_BASE_URL=http://localhost:3103
DATABASE_URL=postgresql+psycopg://supplementpacket_app@localhost:5432/supplementpacket_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER_ROLE@localhost:5432/supplementpacket_dev
# Object storage (B2): S3 API to local MinIO. Credentials are local test values kept only in .env.
STORAGE_BACKEND=s3
STORAGE_BUCKET=supplementpacket-dev
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Email (B2): SMTP to local Mailpit (no authentication); inbox at http://127.0.0.1:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=SupplementPacket <no-reply@supplementpacket.test>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SESSION_KEY=
API_PORT=8103
LOG_LEVEL=INFO
WORKER_HEARTBEAT_PATH=.run/worker.heartbeat
